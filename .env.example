# ツチノート 環境変数
# コピーして .env にリネームし、各値を設定

# OpenWeatherMap API
OPENWEATHER_API_KEY=

# Google AI Studio (Gemini)
GEMINI_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_LIGHT=
STRIPE_PRICE_PRO=

# JWT
JWT_SECRET=your-secret-key-here

# App
APP_URL=http://localhost:8788
